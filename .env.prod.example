# Variáveis de produção — copiar para /app/.env no droplet.
# Nunca commitar este arquivo preenchido.

APP_ENV=production

# Banco de dados (a senha também vai em POSTGRES_PASSWORD para o docker compose)
POSTGRES_PASSWORD=troque-por-senha-forte

# JWT — gere com: openssl rand -hex 32
SECRET_KEY=

# CORS — URL pública do servidor
FRONTEND_URL=http://67.205.129.68

# WhatsApp (Meta Business API)
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=

# Twilio (sandbox WhatsApp — download de mídia)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# IA
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Fiscal (opcional no MVP)
CERT_A1_PATH=/secrets/cert.pfx
CERT_A1_PASSWORD=
AMBIENTE_SEFAZ=homologacao

# SINESP — proxy para consulta de placas (opcional)
# SINESP_PROXY_URL=socks5://user:pass@host:1080
