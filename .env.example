# ── Global (todas as apps) ────────────────────────────────────────────────────
APP_ENV=development                          # development | production

# JWT — compartilhado entre apps (packages/auth usa estas variáveis)
SECRET_KEY=troque-por-um-segredo-forte-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=60

# URL do frontend (CORS em produção) — deixar vazio em dev
FRONTEND_URL=

# ── App: producao ─────────────────────────────────────────────────────────────

# Admin criado automaticamente na primeira inicialização
BOOTSTRAP_ADMIN_EMAIL=admin@dimata.dev
BOOTSTRAP_ADMIN_SENHA=dev1234
BOOTSTRAP_ADMIN_NOME=Admin Di Mata
BOOTSTRAP_ADMIN_WHATSAPP_PHONE=             # ex: +5511999990000

# Twilio / WhatsApp — obter em https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_VALIDATE_SIGNATURE=False             # True em produção valida HMAC

# PostgreSQL — fila de mensagens WhatsApp (opcional em dev)
# ex: postgresql://user:pass@localhost/dimata
DATABASE_URL=

# Rate limit e debounce (WhatsApp)
DEBOUNCE_WINDOW_SECONDS=2.0
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60

# ── App: oficinas ─────────────────────────────────────────────────────────────

# PostgreSQL do app de oficinas
# Docker: postgresql://oficinas:oficinas@localhost:5432/oficinas
# Local:  postgresql://user:pass@localhost/oficinas
OFICINAS_DATABASE_URL=postgresql://oficinas:oficinas@localhost:5432/oficinas
